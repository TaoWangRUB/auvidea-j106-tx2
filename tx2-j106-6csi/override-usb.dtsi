/* Auvidea J106 carrier - USB VBUS fix (appended to decompiled stock R32.7.6 c03 DTB)
 *
 * Stock gates vdd_usb2_5v with an I2C GPIO expander (ti,tca9539 @0x74) that is
 * absent on the J106 carrier. The regulator therefore never enables and
 * xusb_padctl defers forever (-EPROBE_DEFER/-517) -> all USB dead.
 * Drop the expander gpio and force the fixed regulator always-on so no consumer
 * (port vbus-supply or padctl vbus-2-supply) can defer on the missing chip.
 */
&{/fixed-regulators/regulator@17} {
	/delete-property/ gpio;
	regulator-always-on;
	regulator-boot-on;
};

/* Micro-USB / OTG device mode (USB0 leaves the J106 via M110 connector J17).
 *
 * Force usb2-0 to DEVICE mode so the xudc device controller owns the port and the
 * L4T usb-device-mode gadget (acm.GS0 + rndis/ncm + mass_storage) binds to the UDC.
 * Verified on the board: usb2-0 mode=device, xudc active, gadget bound to
 * UDC 3550000.xudc, /dev/ttyGS0 present. On a properly OTG-wired carrier this makes
 * the micro-USB enumerate on a host PC as /dev/ttyACM0 (serial console) +
 * 192.168.55.1 (USB net) — NOT ttyS0 (that is UART0, a separate link).
 *
 * ⚠️ On the M110 (J17) it still does NOT enumerate: dmesg shows
 *    `tegra-xudc 3550000.xudc: vbus state: 0`  and  `extcon@1: USB_HOST=1`
 * i.e. the OTG ID/VBUS detect (stock devkit GPIOs, floating on the carrier) reads
 * the port as HOST and xudc never sees the host's VBUS, so it stays in ELPG and the
 * gadget never goes online. This is the §7 / §7.1a M110 OTG-routing limitation, not
 * a software bug — confirmed at register level. (Stripping xudc's extcon/otg-controller
 * to force pure-device instead breaks the padctl with -517, so it is NOT done here.)
 * The working TX1 BSP avoided this by using PMU VBUS detection; on a devkit-wired
 * micro-USB (e.g. XCB-Lite, "function identical to devkit") this binding works as-is.
 */
&{/xusb_padctl@3520000/ports/usb2-0} {
	mode = "device";
};
