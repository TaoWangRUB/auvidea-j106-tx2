+#ifndef __IMX296_I2C_TABLES__
+#define __IMX296_I2C_TABLES__
+
+#include <media/camera_common.h>
+
+#define IMX296_TABLE_WAIT_MS	0
+#define IMX296_TABLE_END	1
+
+#define imx296_reg struct reg_8
+
+/* Stream control.
+ * Datasheet: CTRL00[0] = STANDBY, CTRL0A[0] = XMSTA (master start/stop).
+ * Order matters - leave standby first, let the internal PLL settle, then
+ * release XMSTA. Stopping is the exact reverse. */
+static imx296_reg imx296_start_stream[] = {
+	{0x3000, 0x00},			/* CTRL00: clear STANDBY */
+	{IMX296_TABLE_WAIT_MS, 5},
+	{0x300a, 0x00},			/* CTRL0A: release XMSTA */
+	{IMX296_TABLE_END, 0x00}
+};
+
+static imx296_reg imx296_stop_stream[] = {
+	{0x300a, 0x01},			/* CTRL0A: XMSTA (master stop) */
+	{0x3000, 0x01},			/* CTRL00: STANDBY */
+	{IMX296_TABLE_END, 0x00}
+};
+
+/* Sensor initialisation sequence.
+ *
+ * These registers are NOT described in the datasheet - they are the vendor
+ * tuning sequence, reproduced verbatim from the upstream mainline driver
+ * (drivers/media/i2c/imx296.c, imx296_init_table). Do not "clean up", reorder
+ * or tune these values: they are unpublished magic and there is no way to
+ * verify a change against a specification. */
+static imx296_reg imx296_mode_common[] = {
+	{0x3005, 0xf0},
+	{0x309e, 0x04},
+	{0x30a0, 0x04},
+	{0x30a1, 0x3c},
+	{0x30a4, 0x5f},
+	{0x30a8, 0x91},
+	{0x30ac, 0x28},
+	{0x30af, 0x0b},	/* MUST be 0x0b: 0x09 silently breaks XTRIG */
+	{0x30df, 0x00},
+	{0x3165, 0x00},
+	{0x3169, 0x10},
+	{0x316a, 0x02},
+	{0x31c8, 0xf3},	/* Exposure-related */
+	{0x31d0, 0xf4},	/* Exposure-related */
+	{0x321a, 0x00},
+	{0x3226, 0x02},
+	{0x3256, 0x01},
+	{0x3541, 0x72},
+	{0x3516, 0x77},
+	{0x350b, 0x7f},
+	{0x3758, 0xa3},
+	{0x3759, 0x00},
+	{0x375a, 0x85},
+	{0x375b, 0x00},
+	{0x3832, 0xf5},
+	{0x3833, 0x00},
+	{0x38a2, 0xf6},
+	{0x38a3, 0x00},
+	{0x3a00, 0x80},
+	{0x3d48, 0xa3},
+	{0x3d49, 0x00},
+	{0x3d4a, 0x85},
+	{0x3d4b, 0x00},
+	{0x400e, 0x58},
+	{0x4014, 0x1c},
+	{0x4041, 0x2a},
+	{0x40a2, 0x06},
+	{0x40c1, 0xf6},
+	{0x40c7, 0x0f},
+	{0x40c8, 0x00},
+	{0x4174, 0x00},
+	{IMX296_TABLE_END, 0x00}
+};
+
+/* All-pixel scan mode, 1456x1088 RAW10.
+ *
+ * Only the INCK-independent part lives here; HMAX/VMAX, INCKSEL[0..3] and
+ * CTRL418C depend on the board's input clock and are written by
+ * imx296_set_mode(). */
+static imx296_reg imx296_mode_1456x1088[] = {
+	{0x3300, 0x00},			/* FID0_ROI: ROI off - full pixel array */
+	{0x300d, 0x00},			/* CTRL0D: WINMODE_ALL, no binning */
+	{0x4114, 0xc5},			/* GTTABLENUM */
+	{0x3212, 0x08},			/* GAINDLY: no delay */
+	{0x3254, 0x3c},			/* BLKLEVEL (16-bit, LSB) */
+	{0x3255, 0x00},			/* BLKLEVEL MSB */
+	{IMX296_TABLE_END, 0x00}
+};
+
+enum {
+	IMX296_MODE_1456x1088_60FPS,
+	IMX296_MODE_COMMON,
+	IMX296_START_STREAM,
+	IMX296_STOP_STREAM,
+};
+
+static imx296_reg *mode_table[] = {
+	[IMX296_MODE_1456x1088_60FPS]	= imx296_mode_1456x1088,
+	[IMX296_MODE_COMMON]		= imx296_mode_common,
+	[IMX296_START_STREAM]		= imx296_start_stream,
+	[IMX296_STOP_STREAM]		= imx296_stop_stream,
+};
+
+/* Datasheet "All-pixel scan mode", AD = 10 bit: 60.3 frame/s.
+ * Derived check: HMAX 1100 / 74.25 MHz = 14.815 us per line;
+ * 1 / (VMAX 1118 * 14.815 us) = 60.38 frame/s. */
+static const int imx296_60fps[] = {
+	60,
+};
+
+static const struct camera_common_frmfmt imx296_frmfmt[] = {
+	{{1456, 1088}, imx296_60fps, 1, 0, IMX296_MODE_1456x1088_60FPS},
+};
