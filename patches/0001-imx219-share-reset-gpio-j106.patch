+/* J106-derated rates: at the lowered 680 Mbps PLL the binned modes cap below
+ * their stock rates (1640x1232 ~22 fps, 1280x720 ~44 fps). Advertise the real
+ * caps so Argus does not request a rate the sensor timing cannot deliver
+ * (which truncates frames -> ChanselFault). See the matching DT mode nodes. */
+static const int imx219_22fps[] = {
+	22,
+};
