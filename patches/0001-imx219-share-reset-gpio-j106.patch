 	{0x0305, 0x03},
 	{0x0306, 0x00},
-	{0x0307, 0x39},
+	{0x0307, 0x2B}, /* PLL_VT_MPY: was 0x39(57), now 43 — lower MIPI rate for J106 */
 	{0x0309, 0x0A},
 	{0x030B, 0x01},
 	{0x030C, 0x00},
-	{0x030D, 0x72},
+	{0x030D, 0x55}, /* PLL_OP_MPY: was 0x72(114), now 85 — 680 Mbps/lane, matches Auvidea TX1 BSP */
 	{IMX219_TABLE_END, 0x00}
